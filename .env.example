# GGULPING settings. Put them in your RunPod template (or a docker --env-file).
# Comments must be on their own line: docker keeps anything after the = as the value.

# What to eat: a Hugging Face model (id or link), a model folder on the pod, or a .gguf.
# When this is set, the pod starts by itself (no setup screen).
GGULP_MODEL=
# The name: repo <namespace>/<name>-GGUF, files <name>-Q4_K_M.gguf. Empty = the model's name.
GGULP_NAME=
# Your Hugging Face account or org. Empty = your account.
GGULP_NAMESPACE=
# Needs write access. Without it, everything stays on the pod.
HF_TOKEN=

# smart = upload and delete when the next quant won't fit. dump = make everything, then upload.
GGULP_MODE=smart
# Which quants: buffet (all of them), snack (Q8_0 Q6_K Q5_K_M Q4_K_M IQ4_XS Q3_K_M Q2_K), or a list like Q8_0,Q4_K_M
GGULP_QUANTS=buffet
# 1 = private repo, 0 = public
GGULP_PRIVATE=1
# Smart mode: never use more than this many GB. Empty = all the free space.
GGULP_STOMACH_GB=
# Always leave this many GB free.
GGULP_RESERVE_GB=2

# Importance matrix: auto (when there's a GPU), on, or off. The tiniest quants need it.
GGULP_IMATRIX=auto
# Text to run through the model for it: a file or https:// link.
# Empty = bartowski's calibration_datav5 (wikitext-2 if that can't be downloaded).
GGULP_IMATRIX_DATA=
# How much of that text to use, in chunks of 512 tokens. 200 is about 4x faster than all of it
# with nearly the same quants. 0 = all of it (about 800 chunks, what bartowski uses).
GGULP_IMATRIX_CHUNKS=200
# Upload the <name>.imatrix file too
GGULP_UPLOAD_IMATRIX=1

# Files bigger than this are cut into pieces (Hugging Face takes up to 50 GB per file).
GGULP_SPLIT_GB=45
# CPU threads for quantizing. Empty = all of them.
GGULP_THREADS=

# Discord ping when it's done (or if it fails)
GGULP_DISCORD_WEBHOOK=

# Where everything goes on the pod
GGULP_HOME=/workspace/ggulp
# 0 = don't pop the setup screen up when you log in
GGULP_SETUP_SCREEN=1
# ssh: your public key, or a root password
PUBLIC_KEY=
ROOT_PASSWORD=
